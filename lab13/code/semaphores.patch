diff --git a/xv6-riscv/kernel/sem.c b/xv6-riscv/kernel/sem.c
new file mode 100644
index 0000000..2ba5130
--- /dev/null
+++ b/xv6-riscv/kernel/sem.c
@@ -0,0 +1,84 @@
+// Lab 13: eight global counting semaphores, shared by all processes.
+#include "types.h"
+#include "riscv.h"
+#include "defs.h"
+#include "param.h"
+#include "spinlock.h"
+#include "proc.h"
+
+#define NSEM 8
+#define SEM_MAX 0x7fffffff
+
+struct sem {
+  struct spinlock lock;
+  int value;
+};
+static struct sem sems[NSEM];
+
+void
+seminit(void)
+{
+  for (int i = 0; i < NSEM; i++) {
+    initlock(&sems[i].lock, "semaphore");
+    sems[i].value = 0;
+  }
+}
+
+uint64
+sys_sem_init(void)
+{
+  int id, value;
+  argint(0, &id);
+  argint(1, &value);
+  if (id < 0 || id >= NSEM || value < 0)
+    return -1;
+  acquire(&sems[id].lock);
+  sems[id].value = value;
+  release(&sems[id].lock);
+  return 0;
+}
+
+uint64
+sys_sem_down(void)
+{
+  int id;
+  argint(0, &id);
+  if (id < 0 || id >= NSEM)
+    return -1;
+  struct sem *s = &sems[id];
+
+  acquire(&s->lock);
+  while (s->value == 0) {
+    sleep_prepare(s);
+    release(&s->lock);
+    sleep_killable(); // Same two-phase wait, with kill checked atomically.
+    acquire(&s->lock);
+    if (killed(myproc())) {
+      release(&s->lock);
+      return -1;
+    }
+  }
+  s->value--;
+  release(&s->lock);
+  return 0;
+}
+
+uint64
+sys_sem_up(void)
+{
+  int id;
+  argint(0, &id);
+  if (id < 0 || id >= NSEM)
+    return -1;
+  struct sem *s = &sems[id];
+
+  acquire(&s->lock);
+  if (s->value == SEM_MAX) {
+    release(&s->lock);
+    return -1; // Do not overflow the signed counter.
+  }
+  s->value++;
+  wakeup(s);
+  release(&s->lock);
+  return 0;
+}
diff --git a/xv6-riscv/user/semtest.c b/xv6-riscv/user/semtest.c
new file mode 100644
index 0000000..a44d9af
--- /dev/null
+++ b/xv6-riscv/user/semtest.c
@@ -0,0 +1,37 @@
+// Lab 13: the handout's order and ping-pong tests.
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  sem_init(0, 0);
+  if (fork() == 0) {
+    sem_down(0);
+    printf("child: I ran after the parent\n");
+    exit(0);
+  }
+  pause(10);
+  printf("parent: done, I let the child go\n");
+  sem_up(0);
+  wait(0);
+
+  sem_init(1, 1);
+  sem_init(2, 0);
+  if (fork() == 0) {
+    for (int i = 1; i <= 3; i++) {
+      sem_down(2);
+      printf("  pong %d\n", i);
+      sem_up(1);
+    }
+    exit(0);
+  }
+  for (int i = 1; i <= 3; i++) {
+    sem_down(1);
+    printf("ping %d\n", i);
+    sem_up(2);
+  }
+  wait(0);
+  printf("semtest: OK\n");
+  exit(0);
+}
diff --git a/xv6-riscv/user/mix.c b/xv6-riscv/user/mix.c
new file mode 100644
index 0000000..0a25d6f
--- /dev/null
+++ b/xv6-riscv/user/mix.c
@@ -0,0 +1,30 @@
+// Lab 13: one write per character; optionally protect the whole line.
+#include "kernel/types.h"
+#include "user/user.h"
+
+void
+lines(char *s, int uselock)
+{
+  for (int k = 0; k < 5; k++) {
+    if (uselock)
+      sem_down(3);
+    for (char *p = s; *p; p++)
+      write(1, p, 1);
+    if (uselock)
+      sem_up(3);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int uselock = (argc > 1);
+  sem_init(3, 1);
+  if (fork() == 0) {
+    lines("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", uselock);
+    exit(0);
+  }
+  lines("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n", uselock);
+  wait(0);
+  exit(0);
+}
diff --git a/xv6-riscv/user/semcheck.c b/xv6-riscv/user/semcheck.c
new file mode 100644
index 0000000..df0760f
--- /dev/null
+++ b/xv6-riscv/user/semcheck.c
@@ -0,0 +1,111 @@
+// Focused Lab 13 regression tests. Only the parent prints successful results.
+#include "kernel/types.h"
+#include "user/user.h"
+
+static void
+check(int ok, char *message)
+{
+  if (!ok) {
+    fprintf(2, "semcheck: FAIL: %s\n", message);
+    exit(1);
+  }
+}
+
+static void
+joinok(void)
+{
+  int status = -99;
+  check(wait(&status) >= 0 && status == 0, "child exit status");
+}
+
+int
+main(void)
+{
+  for (int id = -1; id <= 8; id += 9) {
+    check(sem_init(id, 0) == -1, "invalid init ID");
+    check(sem_down(id) == -1, "invalid down ID");
+    check(sem_up(id) == -1, "invalid up ID");
+  }
+  check(sem_init(0, -1) == -1, "negative initial value");
+  for (int id = 0; id < 8; id++) {
+    check(sem_init(id, 0) == 0, "initialize valid ID");
+    check(sem_up(id) == 0 && sem_down(id) == 0, "valid ID token round trip");
+  }
+  printf("semcheck: IDs and initial values PASS\n");
+
+  check(sem_init(7, 0x7fffffff) == 0, "maximum count");
+  check(sem_up(7) == -1, "reject count overflow");
+  check(sem_down(7) == 0 && sem_up(7) == 0, "maximum count preserved");
+  check(sem_init(7, 0) == 0, "restore count");
+  printf("semcheck: count overflow guard PASS\n");
+
+  int ready[2], done[2];
+  char byte = 'x';
+  check(pipe(ready) == 0 && pipe(done) == 0, "pipes");
+  check(sem_init(4, 0) == 0, "multiwaiter init");
+  for (int i = 0; i < 6; i++) {
+    int pid = fork();
+    check(pid >= 0, "multiwaiter fork");
+    if (pid == 0) {
+      close(ready[0]);
+      close(done[0]);
+      check(write(ready[1], &byte, 1) == 1, "announce waiter");
+      check(sem_down(4) == 0, "wait for permit");
+      check(write(done[1], &byte, 1) == 1, "announce completion");
+      close(ready[1]);
+      close(done[1]);
+      exit(0);
+    }
+  }
+  close(ready[1]);
+  close(done[1]);
+  for (int i = 0; i < 6; i++)
+    check(read(ready[0], &byte, 1) == 1, "all waiters started");
+  pause(3);
+  for (int i = 0; i < 6; i++) {
+    check(sem_up(4) == 0, "release a permit");
+    check(read(done[0], &byte, 1) == 1, "one waiter completes");
+  }
+  close(ready[0]);
+  close(done[0]);
+  for (int i = 0; i < 6; i++)
+    joinok();
+  printf("semcheck: six waiters and six posts PASS\n");
+
+  check(sem_init(4, 1) == 0 && sem_init(5, 0) == 0, "stress init");
+  int pid = fork();
+  check(pid >= 0, "stress fork");
+  if (pid == 0) {
+    for (int i = 0; i < 1000; i++)
+      check(sem_down(5) == 0 && sem_up(4) == 0, "child handoff");
+    exit(0);
+  }
+  for (int i = 0; i < 1000; i++)
+    check(sem_down(4) == 0 && sem_up(5) == 0, "parent handoff");
+  joinok();
+  printf("semcheck: 1000 ping-pong handoffs PASS\n");
+
+  for (int i = 0; i < 20; i++) {
+    check(pipe(ready) == 0 && sem_init(6, 0) == 0, "kill init");
+    pid = fork();
+    check(pid >= 0, "kill fork");
+    if (pid == 0) {
+      close(ready[0]);
+      check(write(ready[1], &byte, 1) == 1, "announce kill waiter");
+      close(ready[1]);
+      sem_down(6);
+      exit(2); // A non-killed success on an empty semaphore is an error.
+    }
+    close(ready[1]);
+    check(read(ready[0], &byte, 1) == 1, "kill waiter started");
+    close(ready[0]);
+    if (i & 1)
+      pause(1); // Alternate immediate kills and already-blocked waiters.
+    check(kill(pid) == 0, "kill waiter");
+    int status = 0;
+    check(wait(&status) == pid && status == -1, "killed waiter reaped");
+  }
+  printf("semcheck: 20 immediate/blocked waiter kills PASS\n");
+  printf("semcheck: ALL TESTS PASSED\n");
+  exit(0);
+}
diff --git a/xv6-riscv/user/semsleep.c b/xv6-riscv/user/semsleep.c
new file mode 100644
index 0000000..4536906
--- /dev/null
+++ b/xv6-riscv/user/semsleep.c
@@ -0,0 +1,39 @@
+// Let the QEMU harness capture Ctrl-P while a child is blocked in sem_down.
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  int ready[2];
+  if (pipe(ready) < 0 || sem_init(7, 0) < 0)
+    exit(1);
+  int pid = fork();
+  if (pid < 0)
+    exit(1);
+  char byte = 'x';
+  if (pid == 0) {
+    close(ready[0]);
+    if (write(ready[1], &byte, 1) != 1)
+      exit(1);
+    close(ready[1]);
+    if (sem_down(7) < 0)
+      exit(1);
+    exit(0);
+  }
+  close(ready[1]);
+  if (read(ready[0], &byte, 1) != 1)
+    exit(1);
+  close(ready[0]);
+  pause(3);
+  printf("semsleep: blocked child pid %d\n", pid);
+  printf("semsleep: child waiting; inspect with Ctrl-P\n");
+  pause(30);
+  if (sem_up(7) < 0)
+    exit(1);
+  int status = -1;
+  if (wait(&status) != pid || status != 0)
+    exit(1);
+  printf("semsleep: PASS\n");
+  exit(0);
+}
diff --git a/xv6-riscv/user/semprobe.c b/xv6-riscv/user/semprobe.c
new file mode 100644
index 0000000..21cc511
--- /dev/null
+++ b/xv6-riscv/user/semprobe.c
@@ -0,0 +1,13 @@
+// Small deterministic sequence for tracing the three new syscall names.
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  if (sem_init(4, 2) < 0 || sem_down(4) < 0 || sem_down(4) < 0 ||
+      sem_up(4) < 0 || sem_down(4) < 0)
+    exit(1);
+  printf("semprobe: PASS\n");
+  exit(0);
+}
