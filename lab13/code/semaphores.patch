diff --git a/xv6-riscv/kernel/proc.c b/xv6-riscv/kernel/proc.c
index e6bf758..3928f86 100644
--- a/xv6-riscv/kernel/proc.c
+++ b/xv6-riscv/kernel/proc.c
@@ -561,12 +561,16 @@ sleep_prepare(void *chan)
 // Put the thread to sleep.  Assumes sleep_prepare() was called before.
 // If the channel registered by sleep_prepare() has been woken up in
 // the meantime, do not go to sleep, and instead return immediately.
-void
-sleep(void)
+static void
+sleep_common(int interruptible)
 {
   struct proc *p = myproc();
 
   acquire(&p->lock);
+  // Interruptible waits must not miss a kill between registration and sleep.
+  // Other kernel waits keep their original, non-interruptible semantics.
+  if (interruptible && p->killed)
+    p->chan = 0;
   if (p->chan != 0) {
     p->state = SLEEPING;
     sched();
@@ -574,6 +578,19 @@ sleep(void)
   release(&p->lock);
 }
 
+void
+sleep(void)
+{
+  sleep_common(0);
+}
+
+// Semaphore waits may be cancelled by kill, including before actual sleep.
+void
+sleep_killable(void)
+{
+  sleep_common(1);
+}
+
 // Wake up all processes sleeping on channel chan.
 void
 wakeup(void *chan)
